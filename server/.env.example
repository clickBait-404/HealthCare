# Healthcare Appointment & Follow-up Manager - Environment Configuration Template

PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5175

# Database configuration (SQLite for local zero-config, or PostgreSQL / MySQL)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret
JWT_SECRET=super_secret_healthcare_jwt_key_2026_antigravity

# LLM Configuration (Google Gemini or OpenAI API - optional with built-in rule-based fallback)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Email SMTP Service (Nodemailer / Ethereal / SendGrid / Mailgun)
EMAIL_SERVICE=smtp
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM="NexusCare Clinic <appointments@nexuscare.clinic>"

# Google Calendar Integration (OAuth 2.0 or Direct Calendar Links)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5050/api/calendar/oauth/callback
